<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="星签"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!--
            ★ 以下带 noteText 后缀的「灰色小字」都是**解释性说明**，不是状态。
            它们默认收起，由标题下方的「显示使用说明」统一控制（见 notesToggle）。
            注意：警示横幅 warningBanner 不在此列 —— 那是必须首屏可见的状态，永不收起。
        -->
        <TextView
            android:id="@+id/introNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="微博在本机登录，签到在本机自动执行，不需要电脑。"
            android:textColor="#667085"
            android:textSize="13sp"
            android:visibility="gone" />

        <!--
            ★ 版本号必须直接显示在首页。
            用户反馈「改了还是不行」时，第一个要排除的就是「装的是旧包」——
            以前只能靠猜，现在版本号就写在最上面，一眼可辨。
        -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="版本：—"
            android:textColor="#98A2B3"
            android:textSize="12sp" />

        <!--
            ★ 「显示/隐藏使用说明」总开关。

            为什么要有：首页原先散布着 4 处灰色小字说明（本机运行、随机延迟、
            后台权限、诊断报告用途），对**已经会用**的人来说是纯噪音 ——
            每次打开都要在它们中间找状态。但对**第一次用**的人又必须能看到。
            一个开关同时满足两边：默认收起保持干净，想看随时点开。

            用 TextView 而不是 Button：它只是文字链接，不需要按钮的立体感，
            放在标题区也不抢视觉。setOnClickListener 会自动让它可点击。
        -->
        <TextView
            android:id="@+id/notesToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingEnd="12dp"
            android:text="显示使用说明 ▾"
            android:textColor="#2563EB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--
            ★ 常驻警示横幅，放在标题正下方（首屏第一眼就能看到，不用滚动）。

            为什么必须有：用户设了时间、以为已经在自动签到了，实际 scheduleEnabled 还是 false，
            程序一个闹钟都没登记。而原来那句提示藏在页面下方的「自动签到状态」里，
            用户根本不会往下翻 —— 于是反复反馈「到点不执行」，排查方向全被带偏。
            放在最顶上，任何需要用户动手的状态都跑不掉。
        -->
        <TextView
            android:id="@+id/warningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FEF3F2"
            android:padding="12dp"
            android:textColor="#B42318"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="—" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 微博账号"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weiboStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="还没有添加微博账号"
                    android:textColor="#667085" />

                <TextView
                    android:id="@+id/loginCheckStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="尚未检查登录状态"
                    android:textColor="#8A94A6"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/accountList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/addAccountButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="添加微博账号" />

                <Button
                    android:id="@+id/checkLoginButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="检查所有账号登录" />

                <Button
                    android:id="@+id/verifyButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="去微博完成验证（出现「请先验证身份」时用）" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. 设置签到时间"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <DatePicker
                    android:id="@+id/datePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:datePickerMode="spinner" />

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:timePickerMode="spinner" />

                <TextView
                    android:id="@+id/jitterExplainText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="实际执行会在基础时间后随机延迟 0～30 分钟（时间设在 1 小时以内不会延迟，方便当场测试）。"
                    android:textColor="#667085"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/saveScheduleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="保存并开启自动签到" />

                <!--
                    ★ 「测试自动签到」：一键把整条自动链路原样跑一遍。

                    为什么必须有：用户想确认的是「到点程序会不会自己动起来」，
                    而不是「点按钮能不能签到」—— 这两件事走的根本不是同一条路
                    （「立即签到」是直接拉起服务，完全不经过闹钟）。
                    正常流程要选日期、选时间、保存，而且时间必须落在未来；
                    设 5 分钟后还要再等最多 30 分钟的随机延迟，
                    于是「等了半小时没动静」，根本分不清是程序坏了还是本来就没到点。
                    这个按钮做三件事：开启自动签到 → 把闹钟登记到 2 分钟后 → 告诉用户可以息屏等。
                -->
                <Button
                    android:id="@+id/testScheduleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="测试自动签到（2 分钟后执行一次）" />

                <Button
                    android:id="@+id/skipTodayButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="今日不签到" />

                <Button
                    android:id="@+id/disableScheduleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="关闭自动签到" />

                <!--
                    ★ v19.13：状态块拆成「摘要 + 详细」两层。

                    为什么：这一块会长到十几行（执行链 + 每轮的账号明细），
                    而每天真正要看的只有三件事 —— 下次什么时候跑、今天签了几个、上次成没成。
                    其余都是排查用的细节，只在出问题时才需要。

                    ★★ 硬规则：折叠的只能是「一切正常时的细节」。
                       凡是「不处理就一定不会执行」的行，一律留在上面这个摘要里，
                       代码里用 alerts 列表把它们**提升**到摘要区，而不是删掉。
                       （v19.8 的教训：提示藏在下面 → 用户连续三轮反馈「到点不执行」。）
                -->
                <TextView
                    android:id="@+id/scheduleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="自动签到未开启"
                    android:textColor="#667085" />

                <TextView
                    android:id="@+id/statusToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingEnd="12dp"
                    android:text="显示详细状态 ▾"
                    android:textColor="#2563EB"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#8A94A6"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. 后台权限"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/compatNoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Android 不同品牌可能需要允许自启动、后台运行和关闭电池优化。"
                    android:textColor="#667085"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/compatibilityButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="全安卓后台兼容设置" />

                <Button
                    android:id="@+id/batteryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="允许后台和锁屏运行" />

                <Button
                    android:id="@+id/diagnoseButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="复制诊断报告" />

                <TextView
                    android:id="@+id/reportNoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="「复制诊断报告」会把本机当前的后台状态整理成一段文字并复制到剪贴板，直接粘贴给我，就能定位到具体是哪一步没执行。"
                    android:textColor="#667085"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            ★ v0.19.15：自动发帖。
            发帖的风险远高于签到（会被微博判定为机器刷屏），所以：
              ① 默认关闭，必须用户自己填名单、填正文、打开开关才会执行；
              ② 一轮每账号只发 1 条，两条之间隔「间隔分钟」那么久；
              ③ 有「立即发一条」按钮，方便当场验证发帖接口（本机无法编译验证，只能靠实测）。
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. 自动发帖（超话帖子）"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/postEnabledSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="开启自动发帖"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/postHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="每轮每个账号只发 1 条，两条之间会隔开下面填的分钟数。间隔越大越安全。"
                    android:textColor="#667085"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="超话链接（一行一个，粘贴超话页地址）"
                    android:textColor="#344054"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/postTopicsEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:hint="例如（任选一种）：\nhttps://m.weibo.cn/p/index?containerid=100808…\nhttps://weibo.com/p/100808…/super_index"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="帖子正文（多条之间用单独一行 --- 分隔）"
                    android:textColor="#344054"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/postContentEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:hint="只填一段时，所有帖子都用这段文字\n---\n第二段（可选）"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/postCountEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="每个账号几条"
                        android:inputType="number"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/postIntervalEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:hint="间隔（分钟）"
                        android:inputType="number"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/savePostButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="保存发帖设置" />

                <Button
                    android:id="@+id/testPostButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="立即发一条（先试一次，确认能发出去）" />

                <TextView
                    android:id="@+id/postStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="自动发帖未开启"
                    android:textColor="#667085"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/runNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="立即签到" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="等待操作"
            android:textColor="#475467"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
